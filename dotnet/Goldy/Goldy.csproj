<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    
    <!-- Required for source-generated P/Invoke with custom structs -->
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>

    <!-- Package info -->
    <PackageId>Goldy</PackageId>
    <Version>0.1.0</Version>
    <Authors>koubaa</Authors>
    <Description>Modern GPU library for .NET - Vulkan, DX12, Metal. High-performance graphics with Slang shaders.</Description>
    <PackageTags>gpu;graphics;vulkan;rendering;dx12;metal;shader;slang</PackageTags>
    <RepositoryUrl>https://github.com/koubaa/goldy</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Generate package on build -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include native libraries -->
    <None Include="runtimes\**\*" Pack="true" PackagePath="runtimes\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Native library runtime configuration -->
  <ItemGroup>
    <None Include="runtimes\win-x64\native\goldy_ffi.dll" Pack="true" PackagePath="runtimes\win-x64\native\" Condition="Exists('runtimes\win-x64\native\goldy_ffi.dll')" />
    <None Include="runtimes\linux-x64\native\libgoldy_ffi.so" Pack="true" PackagePath="runtimes\linux-x64\native\" Condition="Exists('runtimes\linux-x64\native\libgoldy_ffi.so')" />
    <None Include="runtimes\osx-x64\native\libgoldy_ffi.dylib" Pack="true" PackagePath="runtimes\osx-x64\native\" Condition="Exists('runtimes\osx-x64\native\libgoldy_ffi.dylib')" />
    <None Include="runtimes\osx-arm64\native\libgoldy_ffi.dylib" Pack="true" PackagePath="runtimes\osx-arm64\native\" Condition="Exists('runtimes\osx-arm64\native\libgoldy_ffi.dylib')" />
  </ItemGroup>

</Project>

