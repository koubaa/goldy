<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    
    <!-- Required for source-generated P/Invoke with custom structs -->
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>

    <!-- Package info -->
    <PackageId>Goldy</PackageId>
    <Version>0.1.0</Version>
    <Authors>koubaa</Authors>
    <Description>Modern GPU library for .NET - Vulkan, DX12, Metal. High-performance graphics with Slang shaders.</Description>
    <PackageTags>gpu;graphics;vulkan;rendering;dx12;metal;shader;slang</PackageTags>
    <RepositoryUrl>https://github.com/koubaa/goldy</RepositoryUrl>
    <PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Generate package on build -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include native libraries (goldy_ffi + Slang dependencies) -->
    <!-- Build scripts copy both goldy_ffi and slang-*.dll to runtimes/{rid}/native/ -->
    <None Include="runtimes\**\*" Pack="true" PackagePath="runtimes\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

